# Copy this file to ".env" and fill in the two values from your Supabase project
# (Supabase dashboard -> Project Settings -> API).
#
# These are the "publishable" anon values and are safe to ship in a client
# bundle: access is controlled by the row-level-security policies in
# supabase/schema.sql, not by hiding this key.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
